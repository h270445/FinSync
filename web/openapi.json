          "results"
        ],
        "title": "BulkOut"
      },
      "ErrorOut": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorOut"
      },
      "EventOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "direction": {
            "type": "string",
            "title": "Direction"
          },
          "happened_at": {
            "type": "string",
            "title": "Happened At"
          },
          "merchant": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Merchant"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "primary_transaction_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Transaction Id"
          },
          "review_state": {
            "type": "string",
            "title": "Review State"
          },
          "transactions": {
            "items": {
              "$ref": "#/components/schemas/TransactionOut"
            },
            "type": "array",
            "title": "Transactions"
          }
        },
        "type": "object",
        "required": [
          "id",
          "amount",
          "currency",
          "direction",
          "happened_at",
          "merchant",
          "category",
          "primary_transaction_id",
          "review_state",
          "transactions"
        ],
        "title": "EventOut"
      },
      "EventsOut": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventOut"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "events"
        ],
        "title": "EventsOut"
      },
      "ManualTransactionIn": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "happened_at": {
            "type": "string",
            "title": "Happened At"
          },
          "merchant": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Merchant"
          },
          "direction": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "expense",
                  "income"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Direction"
          },
          "source_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Ref"
          }
        },
        "type": "object",
        "required": [
